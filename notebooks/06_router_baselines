      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Confidence baseline signals:\n",
            "  1. small_confidence  (escalate when low)\n",
            "  2. small_entropy  (escalate when high)\n",
            "  3. small_margin  (escalate when low)\n"
          ]
        }
      ],
      "source": [
        "BASELINE_SIGNALS = [\n",
        "    'small_confidence',\n",
        "    'small_entropy',\n",
        "    'small_margin',\n",
        "]\n",
        "\n",
        "# Direction for escalation:\n",
        "# - confidence / margin: smaller means riskier\n",
        "# - entropy: larger means riskier\n",
        "SIGNAL_DIRECTIONS = {\n",
        "    'small_confidence': 'low',\n",
        "    'small_entropy': 'high',\n",
        "    'small_margin': 'low',\n",
        "}\n",
        "\n",
        "LABEL2ID = {'negative': 0, 'neutral': 1, 'positive': 2}\n",
        "LABEL_NAMES = ['negative', 'neutral', 'positive']\n",
        "\n",
        "print('Confidence baseline signals:')\n",
        "for i, s in enumerate(BASELINE_SIGNALS, 1):\n",
        "    print(f'  {i}. {s}  (escalate when {SIGNAL_DIRECTIONS[s]})')"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "73a9b3d5",
      "metadata": {
        "id": "73a9b3d5"
      },
      "source": [
        "## 4. Helper — build merged dataframe"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "8f147f57",
      "metadata": {
        "id": "8f147f57"
      },
      "outputs": [],
      "source": [
        "def build_merged_df(split_csv, small_preds_csv, large_preds_csv=None):\n",
        "    \"\"\"\n",
        "    Merge small-model uncertainty signals with labels.\n",
        "    If large_preds_csv is provided, also merge large-model predictions and\n",
        "    compute the oracle escalation label.\n",
        "    \"\"\"\n",
        "    df_split = pd.read_csv(split_csv)[['id']].copy()\n",
        "    df_small = pd.read_csv(small_preds_csv)\n",
        "\n",
        "    df_sm = df_small[['id', 'true_label', 'predicted_label',\n",
        "                      'confidence', 'entropy', 'margin']].copy()\n",
        "    df_sm.rename(columns={\n",
        "        'predicted_label': 'small_pred',\n",
        "        'confidence': 'small_confidence',\n",
        "        'entropy':  'small_entropy',\n",
        "        'margin': 'small_margin',\n",
        "    }, inplace=True)\n",
        "\n",
        "    df = df_split.merge(df_sm, on='id', how='inner')\n",
        "    df['small_correct'] = (df['small_pred'] == df['true_label']).astype(int)\n",
        "\n",
        "    if large_preds_csv is not None:\n",
        "        df_lg = pd.read_csv(large_preds_csv)[['id', 'pred_label', 'correct']].copy()\n",
        "        df_lg.rename(columns={'pred_label': 'large_pred', 'correct': 'large_correct'}, inplace=True)\n",
        "        df = df.merge(df_lg, on='id', how='inner')\n",
        "        df['large_correct'] = df['large_correct'].astype(int)\n",
        "        df['escalate'] = ((df['small_correct'] == 0) & (df['large_correct'] == 1)).astype(int)\n",
        "\n",
        "    assert len(df) == len(df_split), f'Row count mismatch: {len(df)} vs {len(df_split)}'\n",
        "    return df\n",
        "\n",
        "\n",
        "def decisions_from_threshold(values, signal_name, threshold):\n",
        "    \"\"\"\n",
        "    Convert a score into 0/1 routing decisions.\n",
        "    1 = escalate to large model, 0 = keep small model.\n",
        "    \"\"\"\n",
        "    direction = SIGNAL_DIRECTIONS[signal_name]\n",
        "    if direction == 'low':\n",
        "        return (values <= threshold).astype(int)\n",
        "    elif direction == 'high':\n",
        "        return (values >= threshold).astype(int)\n",
        "    raise ValueError(f'Unknown direction for {signal_name}: {direction}')\n",
        "\n",
        "\n",
        "def evaluate_thresholds(df, signal_name, n_thresholds=201):\n",
        "    \"\"\"\n",
        "    Sweep thresholds for one signal against oracle escalation labels on val.\n",
        "    \"\"\"\n",
        "    y_true = df['escalate'].values\n",
        "    values = df[signal_name].values\n",
        "\n",
        "    lo, hi = values.min(), values.max()\n",
        "    thresholds = np.linspace(lo, hi, n_thresholds)\n",
        "\n",
        "    rows = []\n",
        "    for t in thresholds:\n",
        "        y_pred = decisions_from_threshold(values, signal_name, t)\n",
        "\n",
        "        rows.append({\n",
        "            'signal': signal_name,\n",
        "            'direction': SIGNAL_DIRECTIONS[signal_name],\n",
        "            'threshold': t,\n",
        "            'accuracy': accuracy_score(y_true, y_pred),\n",
        "            'f1': f1_score(y_true, y_pred, zero_division=0),\n",
        "            'precision': precision_score(y_true, y_pred, zero_division=0),\n",
        "            'recall': recall_score(y_true, y_pred, zero_division=0),\n",
        "            'escalation_rate': y_pred.mean(),\n",
        "        })\n",
        "\n",
        "    out = pd.DataFrame(rows)\n",
        "\n",
        "    # Ranking preference:\n",
        "    # 1) highest F1\n",
        "    # 2) highest accuracy\n",
        "    # 3) lower escalation rate\n",
        "    out = out.sort_values(['f1', 'accuracy', 'escalation_rate'],\n",
        "                          ascending=[False, False, True]).reset_index(drop=True)\n",
        "    return out"
      ]
    },
